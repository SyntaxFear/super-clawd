{
  "name": "super-clawd",
  "version": "0.0.0",
  "description": "A retro platformer starring Clawd, the Claude Code mascot. Fix bugs, collect tokens, beat Copilot.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Levan Parastashvili (https://github.com/SyntaxFear)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyntaxFear/super-clawd.git"
  },
  "homepage": "https://github.com/SyntaxFear/super-clawd#readme",
  "bugs": {
    "url": "https://github.com/SyntaxFear/super-clawd/issues"
  },
  "keywords": [
    "game",
    "platformer",
    "pixel-art",
    "retro",
    "claude-code",
    "typescript",
    "canvas",
    "chiptune"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
